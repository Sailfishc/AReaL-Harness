{
  "publicOrigin": "https://remote.example.org",
  "listen": "127.0.0.1:8080",
  "trustedLocalTlsProxy": true,
  "allowedClientOrigins": [
    "https://remote.example.org"
  ],
  "allowedAppOrigins": [],
  "dataDir": "/var/lib/areal-remote-relay",
  "assetsDir": "/opt/areal-remote-pwa",
  "maxHosts": 100,
  "maxConnections": 256,
  "maxPending": 32,
  "maxChannelsPerHost": 16,
  "maxFrameBytes": 524288,
  "maxBufferedBytesPerChannel": 2097152,
  "payloadLogging": false,
  "apns": {
    "teamId": "ABCDEFGHIJ",
    "keyId": "KLMNOPQRST",
    "keyFile": "/etc/areal-relay/apns.p8",
    "bundleId": "org.example.areal",
    "maxPerHostPerMinute": 60
  }
}
